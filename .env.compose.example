# Copy to .env (never commit real secrets).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUDORA_API_KEY=replace-with-at-least-32-random-characters
AUDORA_MODEL_DIR=./models/audora
AUDORA_PORT=3000
AUDORA_BRAND_NAME=Audora
AUDORA_BRAND_TAGLINE=Your intelligent workspace
AUDORA_RATE_LIMIT_MAX=30
AUDORA_RATE_LIMIT_WINDOW_MS=60000

# Optional: set only when SearXNG is reachable from the app container.
# AUDORA_SEARCH_URL=http://searxng:8080/search
