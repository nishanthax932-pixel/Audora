# Default: no setup at all. With no variables set, Audora answers through a free
# shared model tier (AUDORA_PROVIDER=free). It is rate-limited and messages leave
# your machine, so do not chat about secrets on it. No API key is needed.
# AUDORA_PROVIDER=free
# AUDORA_FREE_API_URL=https://text.pollinations.ai/openai

# No-cloud-key local mode: install Ollama, pull a model, then run Audora.
# AUDORA_PROVIDER=ollama
# AUDORA_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# AUDORA_MODEL=qwen3:8b

# Your own hosted OpenAI-compatible provider:
# AUDORA_PROVIDER=compatible
# AUDORA_API_URL=https://provider.example/v1/chat/completions
# AUDORA_API_KEY=replace-me

# JSON model list. `id` is sent to the provider; `label` is shown to users.
# AUDORA_MODELS=[{"id":"openai","label":"Audora Core"}]

# White-label settings (safe to expose to the browser).
AUDORA_BRAND_NAME=Audora
AUDORA_BRAND_TAGLINE=Your intelligent workspace
AUDORA_ACCENT_COLOR=#805ad5
AUDORA_WELCOME_MESSAGE=How can I help you today?
PORT=3000
# Public abuse protection. Use a shared limiter for multiple server instances.
AUDORA_RATE_LIMIT_MAX=30
AUDORA_RATE_LIMIT_WINDOW_MS=60000
AUDORA_REQUEST_TIMEOUT_MS=60000
# Comma-separated browser origins allowed to call a separately hosted API.
# Leave blank when the UI and API are hosted together.
AUDORA_ALLOWED_ORIGINS=
