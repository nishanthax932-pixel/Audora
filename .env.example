# An OpenAI-compatible chat-completions endpoint.
AUDORA_API_URL=https://api.openai.com/v1/chat/completions
AUDORA_API_KEY=replace-me
AUDORA_MODEL=gpt-4.1-mini
# JSON model list. `id` is sent to the provider; `label` is shown to users.
AUDORA_MODELS=[{"id":"gpt-4.1-mini","label":"Audora Core"}]
# White-label settings (safe to expose to the browser).
AUDORA_BRAND_NAME=Audora
AUDORA_BRAND_TAGLINE=Your intelligent workspace
AUDORA_ACCENT_COLOR=#10a37f
AUDORA_WELCOME_MESSAGE=How can I help you today?
PORT=3000
# Public abuse protection. Use a shared limiter for multiple server instances.
AUDORA_RATE_LIMIT_MAX=30
AUDORA_RATE_LIMIT_WINDOW_MS=60000
AUDORA_REQUEST_TIMEOUT_MS=60000
