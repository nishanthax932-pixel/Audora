# Default: self-hosted OpenAI-compatible inference using vLLM and open weights.
# Use an unquantized BF16/FP16 safetensors checkpoint.
AUDORA_PROVIDER=compatible
AUDORA_API_URL=http://127.0.0.1:8000/v1/chat/completions
AUDORA_API_KEY=replace-with-a-long-random-secret
AUDORA_MODEL=audora-local

# Optional self-hosted SearXNG web search endpoint (enable JSON output in SearXNG settings).
# Example: http://127.0.0.1:8080/search
# AUDORA_SEARCH_URL=http://127.0.0.1:8080/search

# Optional Audora-owned local image model service (see image/README.md).
# AUDORA_IMAGE_API_URL=http://127.0.0.1:8001/generate
# AUDORA_IMAGE_API_KEY=replace-with-a-long-random-secret

# Optional Ollama mode. Many Ollama model files are quantized; use vLLM above
# when you specifically want the full BF16/FP16 checkpoint.
# AUDORA_PROVIDER=ollama
# AUDORA_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# AUDORA_MODEL=qwen3:8b

# Optional model list: [{"id":"audora-local","label":"Audora Core"}]
AUDORA_BRAND_NAME=Audora
AUDORA_BRAND_TAGLINE=Your intelligent workspace
AUDORA_ACCENT_COLOR=#805ad5
AUDORA_WELCOME_MESSAGE=How can I help you today?
PORT=3000
AUDORA_RATE_LIMIT_MAX=30
AUDORA_RATE_LIMIT_WINDOW_MS=60000
AUDORA_REQUEST_TIMEOUT_MS=60000
AUDORA_ALLOWED_ORIGINS=
# Set to 1 only behind exactly one trusted reverse proxy.
# AUDORA_TRUST_PROXY=1
