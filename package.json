{
  "name": "audora",
  "version": "0.1.0",
  "private": true,
  "description": "Audora — an online, configurable AI assistant.",
  "type": "module",
  "scripts": {
    "start": "node -r dotenv/config server.js",
    "dev": "node -r dotenv/config --watch server.js",
    "build": "node --check server.js && node --check public/app.js && node --check public/image.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1"
  }
}
